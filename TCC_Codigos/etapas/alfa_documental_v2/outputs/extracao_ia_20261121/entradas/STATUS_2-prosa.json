    "nome": "Status Report Alfa — atualizado após o aviso da MotorTech (prosa)",
    "trechos": [
      {
        "id": "SRP2.RESUMO",
        "localizador": "§Resumo",
        "texto": "Resumo: o projeto está fora do cronograma; o lançamento passou para o dia 45 e o custo previsto subiu para R$ 153.500,00, acima do orçamento."
      },
      {
        "id": "SRP2.SUPRIMENTOS",
        "localizador": "§Suprimentos",
        "texto": "Suprimentos: a MotorTech entregará o motor no dia 25, e essa entrega passou a determinar o prazo final. Os demais fornecedores (GearWorks, MetalForm, SensePro e ElecBoard) seguem conforme o previsto."
      },
      {
        "id": "SRP2.ENGENHARIA",
        "localizador": "§Engenharia",
        "texto": "Engenharia: o congelamento do projeto foi concluído no dia 14 e o desenho CAD está na revisão 1."
      },
      {
        "id": "SRP2.TESTES",
        "localizador": "§Testes",
        "texto": "Testes: a campanha de validação deve terminar no dia 40."
      }
    ]
  },
