        "role": "user",
        "content": "{\"versao\": \"1-extracao-afirmacoes\", \"documento\": {\"id\": \"RISK\", \"versao\": \"1-prosa\", \"artefato\": \"risk_register\", \"trechos\": [{\"id\": \"RSKP.R01\", \"texto\": \"R-01 — Possível nova ruptura no fornecimento do motor pela MotorTech. Probabilidade ainda não avaliada; responsável: Carla. Situação: em monitoramento.\"}]}, \"entidades\": [{\"id\": \"SUP_MOTOR\", \"nome\": \"Fornecedor MotorTech\", \"tipo\": \"fornecedor\"}, {\"id\": \"SUP_GEAR\", \"nome\": \"Fornecedor GearWorks\", \"tipo\": \"fornecedor\"}, {\"id\": \"SUP_HOUSING\", \"nome\": \"Fornecedor MetalForm\", \"tipo\": \"fornecedor\"}, {\"id\": \"SUP_SENSOR\", \"nome\": \"Fornecedor SensePro\", \"tipo\": \"fornecedor\"}, {\"id\": \"SUP_ELEC\", \"nome\": \"Fornecedor ElecBoard\", \"tipo\": \"fornecedor\"}, {\"id\": \"C_MOTOR\", \"nome\": \"Motor elétrico\", \"tipo\": \"componente\"}, {\"id\": \"C_GEARBOX\", \"nome\": \"Redutor planetário\", \"tipo\": \"componente\"}, {\"id\": \"C_HOUSING\", \"nome\": \"Carcaça usinada\", \"tipo\": \"componente\"}, {\"id\": \"C_SHAFT\", \"nome\": \"Eixo de saída\", \"tipo\": \"componente\"}, {\"id\": \"C_BEARING\", \"nome\": \"Rolamento principal\", \"tipo\": \"componente\"}, {\"id\": \"C_SENSOR\", \"nome\": \"Sensor de posição\", \"tipo\": \"componente\"}, {\"id\": \"C_COUPLING\", \"nome\": \"Acoplamento\", \"tipo\": \"componente\"}, {\"id\": \"C_PCB\", \"nome\": \"Placa de controle\", \"tipo\": \"componente\"}, {\"id\": \"C_HARNESS\", \"nome\": \"Chicote elétrico\", \"tipo\": \"componente\"}, {\"id\": \"C_SEAL\", \"nome\": \"Conjunto de vedação\", \"tipo\": \"componente\"}, {\"id\": \"T_REQ\", \"nome\": \"Consolidar requisitos\", \"tipo\": \"atividade\"}, {\"id\": \"T_DESIGN\", \"nome\": \"Projeto conceitual\", \"tipo\": \"atividade\"}, {\"id\": \"T_CAD\", \"nome\": \"Detalhamento CAD\", \"tipo\": \"atividade\"}, {\"id\": \"T_FEA\", \"nome\": \"Análise estrutural\", \"tipo\": \"atividade\"}, {\"id\": \"T_PROC\", \"nome\": \"Compras e fabricação\", \"tipo\": \"atividade\"}, {\"id\": \"T_ASSEMBLY\", \"nome\": \"Montagem do protótipo\", \"tipo\": \"atividade\"}, {\"id\": \"T_DOC\", \"nome\": \"Documentação de validação\", \"tipo\": \"atividade\"}, {\"id\": \"T_RELEASE\", \"nome\": \"Liberação de engenharia\", \"tipo\": \"atividade\"}, {\"id\": \"TEST_LOAD\", \"nome\": \"Teste de carga\", \"tipo\": \"teste\"}, {\"id\": \"TEST_THERMAL\", \"nome\": \"Teste térmico\", \"tipo\": \"teste\"}, {\"id\": \"TEST_LIFE\", \"nome\": \"Teste de vida\", \"tipo\": \"teste\"}, {\"id\": \"TEST_SEAL\", \"nome\": \"Teste de vedação\", \"tipo\": \"teste\"}, {\"id\": \"TEST_EMC\", \"nome\": \"Teste de compatibilidade eletromagnética\", \"tipo\": \"teste\"}, {\"id\": \"M_DESIGN_FREEZE\", \"nome\": \"Design Freeze\", \"tipo\": \"marco\"}, {\"id\": \"M_PROTO_READY\", \"nome\": \"Protótipo disponível\", \"tipo\": \"marco\"}, {\"id\": \"M_VALIDATION\", \"nome\": \"Validação concluída\", \"tipo\": \"marco\"}, {\"id\": \"M_RELEASE\", \"nome\": \"Liberação de engenharia\", \"tipo\": \"marco\"}, {\"id\": \"AREA_ENG\", \"nome\": \"Engenharia\", \"tipo\": \"area\"}, {\"id\": \"AREA_SUPPLY\", \"nome\": \"Suprimentos\", \"tipo\": \"area\"}, {\"id\": \"AREA_QUALITY\", \"nome\": \"Qualidade e validação\", \"tipo\": \"area\"}, {\"id\": \"AREA_PM\", \"nome\": \"Gestão do projeto\", \"tipo\": \"area\"}, {\"id\": \"P_ANA\", \"nome\": \"Ana - gerente do projeto\", \"tipo\": \"pessoa\"}, {\"id\": \"P_BRUNO\", \"nome\": \"Bruno - engenharia mecânica\", \"tipo\": \"pessoa\"}, {\"id\": \"P_CARLA\", \"nome\": \"Carla - suprimentos\", \"tipo\": \"pessoa\"}, {\"id\": \"P_DIEGO\", \"nome\": \"Diego - validação\", \"tipo\": \"pessoa\"}, {\"id\": \"PROJECT\", \"nome\": \"Projeto Alfa (custo total)\", \"tipo\": \"projeto\"}, {\"id\": \"DOC_CAD\", \"nome\": \"Desenho CAD\", \"tipo\": \"documento_tecnico\"}], \"predicados\": {\"valor\": \"Valor exato ou pendente de um atributo: data (inicio/fim em dia_corrido desde D0) de uma entidade executável, ou custo total do PROJECT em BRL_centavo.\", \"sem_alteracao\": \"O texto afirma que as datas (campo inicio/fim) ou o custo (campo custo) das entidades listadas seguem como previsto. valor=null.\", \"no_prazo\": \"Situação de um marco (M_*) em relação ao planejado: valor=true se dentro do prazo, false se fora. campo=fim.\", \"dentro_orcamento\": \"Situação do custo do PROJECT em relação ao orçamento: valor=true se dentro, false se acima. campo=custo.\", \"critico\": \"A entidade está (true) ou não está (false) no caminho que determina o prazo final. campo=null.\", \"versao\": \"Versão ou revisão vigente de um documento técnico (ex.: DOC_CAD). campo=versao, unidade=versao, valor em texto.\", \"compromisso\": \"Ação com responsável, prazo e situação. entidades=objetos da ação (não pessoas); registro obrigatório.\", \"risco\": \"Risco futuro registrado. entidades=objetos do risco; campo=dimensão afetada (fim ou custo); registro obrigatório.\", \"decisao\": \"Decisão tomada e registrada. entidades=objetos da decisão; registro obrigatório.\"}}"
